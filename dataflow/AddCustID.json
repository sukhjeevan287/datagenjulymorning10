{
	"name": "AddCustID",
	"properties": {
		"type": "Flowlet",
		"typeProperties": {
			"sources": [],
			"sinks": [],
			"transformations": [
				{
					"name": "derivedColumn1"
				},
				{
					"name": "input1"
				},
				{
					"name": "output1"
				}
			],
			"scriptLines": [
				"input(output(",
				"          CustomerID as integer",
				"     ),",
				"     order: 0,",
				"     allowSchemaDrift: true) ~> input1",
				"input1 derive(CustomerIDFull = concat('CUST - ',toString(CustomerID))) ~> derivedColumn1",
				"derivedColumn1 output() ~> output1"
			]
		}
	}
}